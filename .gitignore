**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.fvm/flutter_sdk
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/

# Web related
**/lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
**/android/app/debug
**/android/app/profile
**/android/app/release

# Pub workspace: member lockfiles are deleted after root pub get
# Keep overrides local-only if ever needed
pubspec_overrides.yaml
**/pubspec_overrides.yaml
