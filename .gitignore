.history
.svn/

# Environment variables
.env
.env.local
**/.env
!**/.env.example
!**/.env.development
!**/.env.staging
!**/.env.production

# App-owned Firebase configuration and release credentials
**/google-services.json
**/GoogleService-Info.plist
**/.secrets/*
!**/.secrets/.gitkeep

# Bundler (project-local gems)
/vendor/bundle/
.bundle/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Draw.io autosave leftovers
*.drawio.bkp
*.drawio.dtmp
.$*.drawio.*

# The .vscode folder contains launch configuration and tasks you configure in
