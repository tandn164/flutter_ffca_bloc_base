{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://composable.dev/schemas/composable_config.schema.json",
  "title": "ComposableCoreConfig",
  "type": "object",
  "required": ["app", "packages"],
  "additionalProperties": true,
  "properties": {
    "app": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "flavor": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        }
      },
      "additionalProperties": true
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/packageNode"
      }
    },
    "devTools": {
      "type": "object",
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "packageNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/packageNode"
          }
        }
      ]
    }
  }
}
