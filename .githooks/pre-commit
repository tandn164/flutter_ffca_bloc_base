#!/usr/bin/env bash

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

changed_dart=()
while IFS= read -r file; do
  [[ -n "$file" ]] && changed_dart+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')

if [[ "${#changed_dart[@]}" -gt 0 ]]; then
  fvm dart format --output=none --set-exit-if-changed "${changed_dart[@]}"
fi

APP="${APP:-sample_app}" bash tool/analyze_all.sh
