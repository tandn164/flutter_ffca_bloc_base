# API Configuration
API_BASE_URL=https://api.example.com
API_TIMEOUT=30000

# Environment (development, staging, production)
APP_ENV=production
DEBUG_MODE=false

# Auth Configuration — replace locally, do not commit real secrets
JWT_SECRET=replace-me
REFRESH_TOKEN_EXPIRY=7200000

# App Configuration
APP_NAME=Flutter FFCA Base
APP_VERSION=1.0.0

# Features Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
